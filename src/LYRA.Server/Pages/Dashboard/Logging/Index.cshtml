@page
@model LYRA.Server.Pages.Dashboard.Logging.IndexModel
@{
    ViewData["Title"] = "Live Log Monitor";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="mb-3 fw-bold">
            <i class="bi bi-activity me-2"></i> Live Log Monitor
        </h2>

        <p class="text-light-emphasis mb-4">
            View structured logs in real-time as they are generated by the system.
        </p>

        <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
            <table class="table table-sm table-bordered table-hover text-nowrap"
                   style="font-family: monospace; background-color: black; color: white;">
                <thead style="background-color: #111; color: #ccc;" class="sticky-top">
                    <tr>
                        <th scope="col">Timestamp</th>
                        <th scope="col">Status</th>
                        <th scope="col">Type</th>
                        <th scope="col">Description</th>
                        <th scope="col">Source</th>
                        <th scope="col">Caller</th>
                        <th scope="col">Target</th>
                        <th scope="col">Signature</th>
                    </tr>
                </thead>
                <tbody id="logContainer">
                    @foreach (var log in Model.Logs)
                    {
                        <tr style="background-color: black;">
                            <td class="text-muted">@log.Timestamp</td>
                            <td class="@log.StatusColor fw-bold">@log.Status.ToUpperInvariant()</td>
                            <td><strong>@log.Type</strong></td>
                            <td>@log.Description</td>
                            <td>@log.Source</td>
                            <td class="text-info fw-medium">@log.CallerSystem</td>
                            <td class="text-info fw-medium">@log.TargetSystem</td>
                            <td class="text-secondary">@log.SignatureHash</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const container = document.getElementById("logContainer");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/activityHub")
            .build();

        connection.on("ReceiveLog", function (log) {
            const status = log.status?.toUpperCase() ?? "INFO";
            const colorClass = {
                "SUCCESS": "text-success",
                "FAIL": "text-danger",
                "ERROR": "text-danger",
                "WARNING": "text-warning",
                "CRITICAL": "text-danger fw-bold"
            }[status] || "text-secondary";

            const row = document.createElement("tr");
            row.innerHTML = `
                <td class="text-muted">${log.timestamp}</td>
                <td class="${colorClass} fw-bold">${status}</td>
                <td><strong>${log.type}</strong></td>
                <td>${log.description}</td>
                <td>${log.source}</td>
                <td class="text-info fw-medium">${log.callerSystem ?? ""}</td>
                <td class="text-info fw-medium">${log.targetSystem ?? ""}</td>
                <td class="text-secondary" style="max-width: 200px; overflow-x: auto;">${log.signatureHash ?? ""}</td>
            `;

            container.prepend(row);

            if (container.scrollTop < 50) {
                container.scrollTop = 0;
            }
        });

        connection.start().catch(err => console.error(err));
    </script>
}