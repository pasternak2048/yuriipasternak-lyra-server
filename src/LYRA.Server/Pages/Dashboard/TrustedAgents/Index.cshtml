@page
@model LYRA.Server.Pages.Dashboard.TrustedAgents.IndexModel
@{
    ViewData["Title"] = "Trusted Agents";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-person-badge me-2"></i> Trusted Agents
        </h2>

        <form method="get" class="mb-4 row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Company</label>
                <select name="CompanyId" class="form-select">
                    <option value="">All Companies</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(Model.Filters.CompanyId == c.Id ? "selected" : null)">
                            @c.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <input type="text" name="Name" class="form-control" value="@Model.Filters.Name" placeholder="Search by name..." />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-light w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>

        <table class="table table-dark table-hover table-bordered align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Mode</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in Model.Agents.Items)
                {
                    <tr>
                        <td>@agent.Name</td>
                        <td>@agent.CompanyName</td>
                        <td>
                            @if (agent.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@agent.Mode</td>
                        <td>@agent.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Pagination" class="mt-4">
            <ul class="pagination">
                @for (int i = 1; i <= Model.Agents.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Filters.Page ? "active" : "")">
                        <a class="page-link" href="?CompanyId=@Model.Filters.CompanyId&Name=@Model.Filters.Name&page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>