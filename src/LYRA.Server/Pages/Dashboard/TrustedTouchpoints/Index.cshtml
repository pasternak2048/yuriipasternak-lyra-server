@page
@using LYRA.Server.Enums
@model LYRA.Server.Pages.Dashboard.TrustedTouchpoints.IndexModel
@{
    ViewData["Title"] = "Trusted Touchpoints";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-diagram-3 me-2"></i> Trusted Touchpoints
        </h2>
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success">@msg</div>
        }
        <form method="get" class="mb-4 row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Company</label>
                <select name="CompanyId" class="form-select">
                    <option value="">All Companies</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(Model.Filters.CompanyId == c.Id ? "selected" : null)">
                            @c.SystemName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <input type="text" name="SystemName" class="form-control" value="@Model.Filters.SystemName" placeholder="Search by name..." />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-light w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>

        <a asp-page="Create" class="btn btn-outline-success mb-3">
            <i class="bi bi-plus-circle me-1"></i> New Touchpoint
        </a>

        <table class="table table-dark table-hover table-bordered align-middle">
            <thead>
                <tr>
                    <th>Display Name</th>
                    <th>System Name</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Use Company Secret</th>
                    <th>Mode</th>
                    <th>Signature</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Touchpoints.Items)
                {
                    <tr style="cursor: pointer;" onclick="location.href='@Url.Page("Details", new { id = t.Id })'">
                        <td class="fw-semibold text-decoration-underline text-info">
                            @t.DisplayName
                        </td>
                        <td><code>@t.SystemName</code></td>
                        <td>@t.CompanyName</td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (t.UseCompanySecret)
                            {
                                <span class="badge bg-info">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>@t.Mode</td>
                        <td><span class="badge bg-dark">@t.SignatureType</span></td>
                        <td>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Pagination" class="mt-4">
            <ul class="pagination">
                @for (int i = 1; i <= Model.Touchpoints.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Filters.Page ? "active" : "")">
                        <a class="page-link" href="?CompanyId=@Model.Filters.CompanyId&Name=@Model.Filters.SystemName&page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
