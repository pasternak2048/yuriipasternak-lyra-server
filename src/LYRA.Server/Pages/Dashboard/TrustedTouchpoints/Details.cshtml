@page "{id:guid}"
@using LYRA.Server.Enums
@using LYRA.Server.Models.Shared
@model LYRA.Server.Pages.Dashboard.TrustedTouchpoints.DetailsModel
@{
    ViewData["Title"] = "Touchpoint Details";

    var deleteModel = new ConfirmDeleteModel
    {
        ModalId = "confirmDeleteTouchpointModal",
        ObjectDisplayName = Model.Touchpoint?.DisplayName ?? "this touchpoint",
        Page = null,
        ObjectId = Model.Touchpoint!.Id,
        Handler = "Delete"
    };

    var rotateModel = new ConfirmRotateModel
    {
        ModalId = "confirmRotateTouchpointModal",
        ObjectDisplayName = Model.Touchpoint?.Name ?? "this touchpoint",
        ObjectId = Model.Touchpoint!.Id,
        Handler = "Rotate",
        Highlight = "warning",
        Icon = "bi-arrow-clockwise"
    };
}

<link rel="stylesheet" href="~/css/lyra-features.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold m-0">
                <i class="bi bi-diagram-3 me-2"></i> @Model.Touchpoint?.DisplayName
            </h2>
            <div class="d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Touchpoint?.Id" class="btn btn-outline-light">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#@rotateModel.ModalId">
                    <i class="bi bi-arrow-clockwise me-1"></i> Rotate Secret
                </button>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@deleteModel.ModalId">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-3">System Name</dt>
            <dd class="col-sm-9 text-light-emphasis"><code>@Model.Touchpoint?.Name</code></dd>

            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Touchpoint?.CompanyName</dd>

            <dt class="col-sm-3">Is Active</dt>
            <dd class="col-sm-9">
                @if (Model.Touchpoint?.IsActive == true)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Use Company Secret</dt>
            <dd class="col-sm-9">
                @if (Model.Touchpoint?.UseCompanySecret == true)
                {
                    <span class="badge bg-info">Yes</span>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </dd>

            <dt class="col-sm-3">Mode</dt>
            <dd class="col-sm-9">@Model.Touchpoint?.Mode</dd>

            <dt class="col-sm-3">Signature Type</dt>
            <dd class="col-sm-9"><span class="badge bg-dark">@Model.Touchpoint?.SignatureType</span></dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Touchpoint?.Description) ? Model.Touchpoint.Description : "–")</dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.Touchpoint?.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>

<!-- Rotate Modal -->
<partial name="_RotateModalPartial" model="rotateModel" />

<!-- Delete Modal -->
<partial name="_DeleteModalPartial" model="deleteModel" />
