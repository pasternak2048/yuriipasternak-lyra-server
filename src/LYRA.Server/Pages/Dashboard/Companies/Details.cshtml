@page "{id:guid}"
@using LYRA.Server.Enums
@model LYRA.Server.Pages.Dashboard.Companies.DetailsModel
@{
    ViewData["Title"] = "Company Details";
}
<link rel="stylesheet" href="~/css/lyra-features.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold m-0">
                <i class="bi bi-building me-2"></i> @Model.Company?.DisplayName
            </h2>
            <div class="d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Company?.Id" class="btn btn-outline-light">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-page="Delete" asp-route-id="@Model.Company?.Id" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-3">System Name</dt>
            <dd class="col-sm-9 text-light-emphasis"><code>@Model.Company?.Name</code></dd>

            <dt class="col-sm-3">Is Active</dt>
            <dd class="col-sm-9">
                @if (Model.Company?.IsActive == true)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.Company?.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>

        <hr class="border-secondary" />

        <h4 class="fw-semibold mt-4">
            <i class="bi bi-diagram-3 me-2"></i> Trusted Touchpoints
        </h4>

        @if (Model.Touchpoints.Any())
        {
            <table class="table table-dark table-hover table-bordered align-middle mt-3">
                <thead>
                    <tr>
                        <th>Display Name</th>
                        <th>System Name</th>
                        <th>Status</th>
                        <th>Use Company Secret</th>
                        <th>Mode</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Touchpoints)
                    {
                        <tr>
                            <td>@t.DisplayName</td>
                            <td><code>@t.Name</code></td>
                            <td>
                                @if (t.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (t.UseCompanySecret)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>@t.Mode.ToString()</td>
                            <td>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-light-emphasis mt-3">No trusted touchpoints assigned to this company.</p>
        }
    </div>
</div>

<script src="~/js/secret-toggle.js" asp-append-version="true"></script>
