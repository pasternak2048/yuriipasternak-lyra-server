@page "{id:guid}"
@using LYRA.Server.Enums
@model LYRA.Server.Pages.Dashboard.Companies.DetailsModel
@{
    ViewData["Title"] = "Company Details";
}
<link rel="stylesheet" href="~/css/lyra-features.css" asp-append-version="true" />
<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold m-0">
                <i class="bi bi-building me-2"></i> Company: @Model.Company?.Name
            </h2>
            <div class="d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Company?.Id" class="btn btn-outline-light">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-page="Delete" asp-route-id="@Model.Company?.Id" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
        </div>
        <dl class="row">
            <dt class="col-sm-3">Display Name</dt>
            <dd class="col-sm-9">@Model.Company?.DisplayName</dd>

            <dt class="col-sm-3">Is Active</dt>
            <dd class="col-sm-9">
                @if (Model.Company?.IsActive == true)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Secret</dt>
            <dd class="col-sm-9">
                <code class="blurred secret-toggle">@Model.Company?.Secret</code>
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.Company?.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>

        <hr class="border-secondary" />

        <h4 class="fw-semibold mt-4">
            <i class="bi bi-person-badge me-2"></i> Trusted Agents
        </h4>

        @if (Model.Agents.Any())
        {
            <table class="table table-dark table-hover table-bordered align-middle mt-3">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Use Company Secret</th>
                        <th>Secret</th>
                        <th>Mode</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in Model.Agents)
                    {
                        <tr>
                            <td>@agent.Name</td>
                            <td>
                                @if (agent.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (agent.UseCompanySecret)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                @if (agent.Mode == AgentMode.CallerOnly || agent.Mode == AgentMode.Both)
                                {
                                    <div class="small text-muted mt-1">
                                        <code class="blurred secret-toggle">@(agent.UseCompanySecret? Model.Company?.Secret : agent.Secret)</code>
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted mt-1">-</div>
                                }
                            </td>
                            <td>@agent.Mode.ToString()</td>
                            <td>@agent.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-light-emphasis mt-3">No agents assigned to this company.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.secret-toggle').forEach(el => {
            el.addEventListener('click', () => {
                el.classList.toggle('reveal');
            });
        });
    </script>
}