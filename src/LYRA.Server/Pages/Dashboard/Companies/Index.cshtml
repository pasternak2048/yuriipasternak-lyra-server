@page
@model LYRA.Server.Pages.Dashboard.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-building me-2"></i> Companies
        </h2>
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success">@msg</div>
        }

        <form method="get" class="mb-4 row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Search</label>
                <input type="text" name="SystemName" class="form-control" placeholder="Search by name or display name..." value="@Model.Filters.SystemName" />
            </div>
            <div class="col-md-auto d-flex align-items-end">
                <button type="submit" class="btn btn-outline-light">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>

        <a asp-page="Create" class="btn btn-outline-success mb-3">
            <i class="bi bi-plus-circle me-1"></i> New Company
        </a>

        <table class="table table-dark table-hover table-bordered align-middle">
            <thead>
                <tr>
                    <th>Display Name</th>
                    <th>System Name</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var company in Model.Companies.Items)
                {
                    <tr style="cursor: pointer;" onclick="location.href='@Url.Page("Details", new { id = company.Id })'">
                        <td class="fw-semibold text-decoration-underline text-info">
                            @company.DisplayName
                        </td>
                        <td><code>@company.SystemName</code></td>
                        <td>
                            @if (company.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@company.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Pagination" class="mt-4">
            <ul class="pagination">
                @for (int i = 1; i <= Model.Companies.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Filters.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i&Name=@Model.Filters.SystemName">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
