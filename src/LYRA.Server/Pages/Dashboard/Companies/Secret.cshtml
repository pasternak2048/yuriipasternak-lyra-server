@page "{id:guid}"
@model LYRA.Server.Pages.Dashboard.Companies.SecretModel
@{
    ViewData["Title"] = "Generated Secret";
}
<link rel="stylesheet" href="~/css/lyra-features.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-3">
            <i class="bi bi-key me-2"></i> Company Secret Generated
        </h2>
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success">@msg</div>
        }
        <div class="alert alert-warning border border-light-subtle">
            <h5 class="fw-semibold"><i class="bi bi-exclamation-triangle me-2"></i> Important</h5>
            <p class="mb-2">
                Below is the generated secret key for <strong>@Model.DisplayName</strong>.
                <strong>This secret is shown only once</strong>. Copy it now and store it securely.
            </p>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded bg-dark border border-secondary">
            <code class="fw-bold fs-5">@Model.SecretPlaintext</code>
            <button class="btn btn-outline-light btn-sm" onclick="navigator.clipboard.writeText('@Model.SecretPlaintext')">
                <i class="bi bi-clipboard me-1"></i> Copy
            </button>
        </div>
        <h5 class="fw-semibold mt-4">Company Info</h5>
        <dl class="row">
            <dt class="col-sm-3">Display Name</dt>
            <dd class="col-sm-9">@Model.DisplayName</dd>

            <dt class="col-sm-3">System Name</dt>
            <dd class="col-sm-9"><code>@Model.SystemName</code></dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActiveBool)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt</dd>
        </dl>

        <a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-outline-light mt-3">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to Company
        </a>
    </div>
</div>