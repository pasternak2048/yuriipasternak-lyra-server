@page
@model LYRA.Server.Pages.Dashboard.Companies.CreateModel
@{
    ViewData["Title"] = "Create Company";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-plus-circle me-2"></i> Create New Company
        </h2>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <input asp-for="Input.DisplayName" class="form-control" id="displayNameInput" oninput="lyra.updateSlug('displayNameInput', 'generatedName')" />
                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Generated Name (readonly)</label>
                <input type="text" class="form-control" id="generatedName" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Secret" class="form-label">Secret</label>
                <div class="input-group">
                    <input asp-for="Input.Secret" class="form-control" id="secretInput" />
                    <button type="button" class="btn btn-outline-secondary" onclick="lyra.generateSecret('secretInput')">Generate</button>
                </div>
                <span asp-validation-for="Input.Secret" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="Index" class="btn btn-outline-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lyra-utils.js" asp-append-version="true"></script>
    <script>
        lyra.updateSlug('displayNameInput', 'generatedName'); // sync on load
    </script>
}