@page
@model LYRA.Server.Pages.Dashboard.Companies.CreateModel
@{
    ViewData["Title"] = "Create Company";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-plus-circle me-2"></i> Create New Company
        </h2>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <input asp-for="Input.DisplayName" class="form-control" id="displayNameInput" oninput="lyra.filterDisplayName(this); lyra.updateSlug('displayNameInput', 'generatedName');" />
                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Generated Name (readonly)</label>
                <input type="text" class="form-control" id="generatedName" readonly />
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="Index" class="btn btn-outline-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lyra-utils.js" asp-append-version="true"></script>
    <script>
        const input = document.getElementById('displayNameInput');
        if (input) {
            input.addEventListener('input', () => {
                lyra.filterDisplayName(input);
                lyra.updateSlug('displayNameInput', 'generatedName');
            });

            lyra.updateSlug('displayNameInput', 'generatedName');
        }
    </script>
}