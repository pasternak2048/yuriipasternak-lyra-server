@page "{id:guid}"
@model LYRA.Server.Pages.Dashboard.AccessPolicies.EditModel
@{
    ViewData["Title"] = "Edit Access Policy";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-pencil me-2"></i> Edit Access Policy
        </h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-3">
                <label asp-for="Input.CallerSystemName" class="form-label">Caller System Name</label>
                <select asp-for="Input.CallerSystemName" class="form-select" asp-items="Model.TouchpointSelectList">
                    <option value="">Select caller touchpoint...</option>
                </select>
                <span asp-validation-for="Input.CallerSystemName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TargetSystemName" class="form-label">Target System Name</label>
                <select asp-for="Input.TargetSystemName" class="form-select" asp-items="Model.TouchpointSelectList">
                    <option value="">Select target touchpoint...</option>
                </select>
                <span asp-validation-for="Input.TargetSystemName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Allowed Operations</label>
                <div id="operationList">
                    @if (Model.Input.Operations.Count > 0)
                    {
                        foreach (var op in Model.Input.Operations)
                        {
                            var key = Guid.NewGuid().ToString("N");
                            <input type="hidden" name="Input.Operations.index" value="@key" />
                            <div class="input-group mb-2" id="op-@key">
                                <input type="text" class="form-control" name="Input.Operations[@key]" value="@op" />
                                <button type="button" class="btn btn-outline-danger" onclick="lyra.removeOperation('@key')">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        var key = Guid.NewGuid().ToString("N");
                        <input type="hidden" name="Input.Operations.index" value="@key" />
                        <div class="input-group mb-2" id="op-@key">
                            <input type="text" class="form-control" name="Input.Operations[@key]" />
                            <button type="button" class="btn btn-outline-danger" onclick="lyra.removeOperation('@key')">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }
                </div>

                <button type="button" class="btn btn-outline-light btn-sm" onclick="lyra.addOperation()">Add Operation</button>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Context" class="form-label">Context</label>
                <select asp-for="Input.Context" class="form-select">
                    <option value="Http" selected="@("Http" == Model.Input.Context.ToString())">Http</option>
                    <option value="Event" selected="@("Event" == Model.Input.Context.ToString())">Event</option>
                    <option value="Cache" selected="@("Cache" == Model.Input.Context.ToString())">Cache</option>
                    <option value="Grpc" selected="@("Grpc" == Model.Input.Context.ToString())">Grpc</option>
                    <option value="Internal" selected="@("Internal" == Model.Input.Context.ToString())">Internal</option>
                    <option value="Soap" selected="@("Soap" == Model.Input.Context.ToString())">Soap</option>
                </select>
                <span asp-validation-for="Input.Context" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="Input.IsEnabled" class="form-check-input" type="checkbox" />
                <label asp-for="Input.IsEnabled" class="form-check-label">Is Enabled</label>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="Index" class="btn btn-outline-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lyra-utils.js" asp-append-version="true"></script>
}