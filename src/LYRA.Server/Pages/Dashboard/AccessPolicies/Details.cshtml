@page "{id:guid}"
@model LYRA.Server.Pages.Dashboard.AccessPolicies.DetailsModel
@{
    ViewData["Title"] = "Access Policy Details";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-shield-lock me-2"></i> Access Policy Details
            </h2>
            <div class="d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Policy?.Id" class="btn btn-outline-warning">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Policy?.Id"
                      onsubmit="return confirm('Are you sure you want to delete this access policy?');">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-success">@Model.Message</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @if (Model.Policy is not null)
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Caller</dt>
                <dd class="col-sm-9">@Model.Policy.CallerSystemName</dd>

                <dt class="col-sm-3">Target</dt>
                <dd class="col-sm-9">@Model.Policy.TargetSystemName</dd>

                <dt class="col-sm-3">Allowed Routes</dt>
                <dd class="col-sm-9">
                    @foreach (var rule in Model.Policy.Rules)
                    {
                        <div><code>@rule.Method @rule.PathPattern</code></div>
                    }
                </dd>

                <dt class="col-sm-3">Enabled</dt>
                <dd class="col-sm-9">
                    @if (Model.Policy.IsEnabled)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.Policy.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
            </dl>
        }

        <div class="mt-4">
            <a asp-page="Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>