@page "{id:guid}"
@using LYRA.Server.Models.Shared
@model LYRA.Server.Pages.Dashboard.AccessPolicies.DetailsModel
@{
    ViewData["Title"] = "Access Policy Details";

    var deleteModel = new ConfirmDeleteModel
    {
        ModalId = "confirmDeleteAccessPolicyModal",
        ObjectDisplayName = $"{Model.Policy?.CallerSystemName} → {Model.Policy?.TargetSystemName}",
        Page = null,
        ObjectId = Model.Policy!.Id,
        Handler = "Delete"
    };
}

<link rel="stylesheet" href="~/css/lyra-features.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold m-0">
                <i class="bi bi-shield-shaded me-2"></i> Access Policy Details
            </h2>
            <div class="d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Policy?.Id" class="btn btn-outline-light">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@deleteModel.ModalId">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>

        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success">@msg</div>
        }

        @if (!ViewContext.ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <dl class="row">
            <dt class="col-sm-3">Caller System Name</dt>
            <dd class="col-sm-9 text-light-emphasis"><code>@Model.Policy?.CallerSystemName</code></dd>

            <dt class="col-sm-3">Target System Name</dt>
            <dd class="col-sm-9 text-light-emphasis"><code>@Model.Policy?.TargetSystemName</code></dd>

            <dt class="col-sm-3">Operation</dt>
            <dd class="col-sm-9">@Model.Policy?.Operation</dd>

            <dt class="col-sm-3">Context</dt>
            <dd class="col-sm-9">@Model.Policy?.Context.ToString()</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Policy?.IsEnabled == true)
                {
                    <span class="badge bg-success">Enabled</span>
                }
                else
                {
                    <span class="badge bg-secondary">Disabled</span>
                }
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.Policy?.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>

<!-- Delete Modal -->
<partial name="_DeleteModalPartial" model="deleteModel" />
