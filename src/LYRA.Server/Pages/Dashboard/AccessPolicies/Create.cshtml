@page
@model LYRA.Server.Pages.Dashboard.AccessPolicies.CreateModel
@{
    ViewData["Title"] = "Create Access Policy";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-plus-circle me-2"></i> Create Access Policy
        </h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Caller</label>
                <div class="position-relative">
                    @{
                        var caller = Model.Callers.FirstOrDefault(t => t.Id == Model.Input.CallerId);
                        var callerLabel = caller is null ? "" : $"{caller.SystemName} ({caller.DisplayName})";
                    }
                    <input type="text" id="autocompleteCallerInput" class="form-control" autocomplete="off"
                           placeholder="Start typing..." value="@callerLabel" />
                    <input type="hidden" id="autocompleteCallerHiddenId" name="Input.CallerId" value="@Model.Input.CallerId" />
                    <div id="autocompleteCallerDropdown"
                         class="dropdown-menu w-100 shadow autocomplete-dropdown"
                         style="max-height: 200px; overflow-y: auto;"></div>
                </div>
                <span asp-validation-for="Input.CallerId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Target</label>
                <div class="position-relative">
                    @{
                        var target = Model.Targets.FirstOrDefault(t => t.Id == Model.Input.TargetId);
                        var targetLabel = target is null ? "" : $"{target.SystemName} ({target.DisplayName})";
                    }
                    <input type="text" id="autocompleteTargetInput" class="form-control" autocomplete="off"
                           placeholder="Start typing..." value="@targetLabel" />
                    <input type="hidden" id="autocompleteTargetHiddenId" name="Input.TargetId" value="@Model.Input.TargetId" />
                    <div id="autocompleteTargetDropdown"
                         class="dropdown-menu w-100 shadow autocomplete-dropdown"
                         style="max-height: 200px; overflow-y: auto;"></div>
                </div>
                <span asp-validation-for="Input.TargetId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Allowed Routes</label>
                <div id="routeRuleList">
                    @for (int i = 0; i < Model.Input.Rules.Count; i++)
                    {
                        var key = Guid.NewGuid().ToString("N");
                        var method = Model.Input.Rules[i].Method;
                        <input type="hidden" name="Input.Rules.index" value="@key" />
                        <div class="input-group mb-2" id="rule-@key">
                            <select class="form-select" name="Input.Rules[@key].Method" style="max-width: 140px;">
                                <option value="ANY" selected="@(method is "ANY" or "*")">ANY</option>
                                <option value="GET" selected="@(method == "GET")">GET</option>
                                <option value="POST" selected="@(method == "POST")">POST</option>
                                <option value="PUT" selected="@(method == "PUT")">PUT</option>
                                <option value="PATCH" selected="@(method == "PATCH")">PATCH</option>
                                <option value="DELETE" selected="@(method == "DELETE")">DELETE</option>
                                <option value="HEAD" selected="@(method == "HEAD")">HEAD</option>
                                <option value="OPTIONS" selected="@(method == "OPTIONS")">OPTIONS</option>
                            </select>

                            <input type="text"
                                   class="form-control"
                                   name="Input.Rules[@key].PathPattern"
                                   value="@Model.Input.Rules[i].PathPattern"
                                   placeholder="/api/orders/* or /*" />

                            <button type="button" class="btn btn-outline-danger" onclick="lyra.removeRouteRule('@key')">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }

                    @if (Model.Input.Rules.Count == 0)
                    {
                        var key = Guid.NewGuid().ToString("N");
                        <input type="hidden" name="Input.Rules.index" value="@key" />
                        <div class="input-group mb-2" id="rule-@key">
                            <select class="form-select" name="Input.Rules[@key].Method" style="max-width: 140px;">
                                <option value="ANY">ANY</option>
                                <option value="GET" selected>GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="PATCH">PATCH</option>
                                <option value="DELETE">DELETE</option>
                                <option value="HEAD">HEAD</option>
                                <option value="OPTIONS">OPTIONS</option>
                            </select>

                            <input type="text"
                                   class="form-control"
                                   name="Input.Rules[@key].PathPattern"
                                   placeholder="/api/orders/* or /*" />

                            <button type="button" class="btn btn-outline-danger" onclick="lyra.removeRouteRule('@key')">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }
                </div>

                <button type="button" class="btn btn-outline-light btn-sm" onclick="lyra.addRouteRule()">Add Route</button>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="Input.IsEnabled" class="form-check-input" type="checkbox" checked />
                <label asp-for="Input.IsEnabled" class="form-check-label">Is Enabled</label>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="Index" class="btn btn-outline-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lyra-utils.js" asp-append-version="true"></script>
    <script src="~/js/autocomplete.js" asp-append-version="true"></script>

    <script>
        initAutocomplete({
            inputId: "autocompleteCallerInput",
            hiddenInputId: "autocompleteCallerHiddenId",
            dropdownId: "autocompleteCallerDropdown",
            fetchUrl: "/Shared/TrustedTouchpointsAutocomplete"
        });

        initAutocomplete({
            inputId: "autocompleteTargetInput",
            hiddenInputId: "autocompleteTargetHiddenId",
            dropdownId: "autocompleteTargetDropdown",
            fetchUrl: "/Shared/TrustedTouchpointsAutocomplete"
        });
    </script>
}