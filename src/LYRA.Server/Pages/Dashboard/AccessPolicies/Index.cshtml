@page
@model LYRA.Server.Pages.Dashboard.AccessPolicies.IndexModel
@{
    ViewData["Title"] = "Access Policies";
}

<div class="container mt-5">
    <div class="bg-lyra-dark text-light p-4 rounded shadow-sm">
        <h2 class="fw-bold mb-4">
            <i class="bi bi-sliders2-vertical me-2"></i> Access Policies
        </h2>

        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success">@msg</div>
        }

        <form method="get" class="mb-4 row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Caller</label>
                <div class="position-relative">
                    @{
                        var selectedCaller = Model.Callers.FirstOrDefault(t => t.Id == Model.Filters.CallerId);
                        var callerLabel = selectedCaller is null ? "" : $"{selectedCaller.SystemName} ({selectedCaller.DisplayName})";
                    }
                    <input type="text" id="autocompleteCallerInput" class="form-control" autocomplete="off"
                           placeholder="Start typing..." value="@callerLabel" />

                    <input type="hidden" id="autocompleteCallerHiddenId" name="Filters.CallerId" value="@Model.Filters.CallerId" />

                    <div id="autocompleteCallerDropdown"
                         class="dropdown-menu w-100 shadow autocomplete-dropdown"
                         style="max-height: 200px; overflow-y: auto;"></div>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Target</label>
                <div class="position-relative">
                    @{
                        var selectedTarget = Model.Targets.FirstOrDefault(t => t.Id == Model.Filters.TargetId);
                        var targetLabel = selectedTarget is null ? "" : $"{selectedTarget.SystemName} ({selectedTarget.DisplayName})";
                    }
                    <input type="text" id="autocompleteTargetInput" class="form-control" autocomplete="off"
                           placeholder="Start typing..." value="@targetLabel" />

                    <input type="hidden" id="autocompleteTargetHiddenId" name="Filters.TargetId" value="@Model.Filters.TargetId" />

                    <div id="autocompleteTargetDropdown"
                         class="dropdown-menu w-100 shadow autocomplete-dropdown"
                         style="max-height: 200px; overflow-y: auto;"></div>
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-light w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>

        <a asp-page="Create" class="btn btn-outline-success mb-3">
            <i class="bi bi-plus-circle me-1"></i> New Policy
        </a>

        <table class="table table-dark table-hover table-bordered align-middle">
            <thead>
                <tr>
                    <th>Caller</th>
                    <th>Target</th>
                    <th>Context</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Policies.Items)
                {
                    <tr style="cursor: pointer;" onclick="location.href='@Url.Page("Details", new { id = p.Id })'">
                        <td><code>@p.CallerSystemName</code></td>
                        <td><code>@p.TargetSystemName</code></td>
                        <td><span class="badge bg-dark">@p.Context</span></td>
                        <td>
                            @if (p.IsEnabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td>@p.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Pagination" class="mt-4">
            <ul class="pagination">
                @for (int i = 1; i <= Model.Policies.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Filters.Page ? "active" : "")">
                        <a class="page-link"
                           asp-route-Filters.Page="@i"
                           asp-route-Filters.CallerId="@Model.Filters.CallerId"
                           asp-route-Filters.TargetId="@Model.Filters.TargetId">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="~/js/autocomplete.js" asp-append-version="true"></script>

    <script>
        initAutocomplete({
            inputId: "autocompleteCallerInput",
            hiddenInputId: "autocompleteCallerHiddenId",
            dropdownId: "autocompleteCallerDropdown",
            fetchUrl: "/Shared/TrustedTouchpointsAutocomplete"
        });

        initAutocomplete({
            inputId: "autocompleteTargetInput",
            hiddenInputId: "autocompleteTargetHiddenId",
            dropdownId: "autocompleteTargetDropdown",
            fetchUrl: "/Shared/TrustedTouchpointsAutocomplete"
        });
    </script>
}