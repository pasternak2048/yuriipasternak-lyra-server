@using Microsoft.AspNetCore.Identity
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LYRA.Server</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LYRA.Server.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lyra-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lyra-features.css" asp-append-version="true" />
</head>
<body>
    <div class="layout-grid">
        <!-- Sidebar -->
        <div class="sidebar shadow-sm">
            <div>
                <div class="text-center mb-4 title d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-shield-shaded text-light fs-4"></i>
                    <span>LYRA.Server</span>
                </div>

                <nav class="nav flex-column">
                    <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")" asp-page="/Index">
                        <i class="bi bi-house me-2"></i> Home
                    </a>
                    <a class="nav-link @(Context.Request.Path == "/Dashboard" ? "active" : "")" asp-page="/Dashboard/Index">
                        <i class="bi bi-bar-chart-line me-2"></i> Dashboard
                    </a>
                    <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Dashboard/Companies") ? "active" : "") ms-4" asp-page="/Dashboard/Companies/Index">
                        <i class="bi bi-building me-2"></i> Companies
                    </a>
                    <a class="nav-link text-nowrap @(Context.Request.Path.StartsWithSegments("/Dashboard/TrustedTouchpoints") ? "active" : "") ms-4" asp-page="/Dashboard/TrustedTouchpoints/Index">
                        <i class="bi bi-diagram-3 me-2"></i> Trusted Touchpoints
                    </a>
                    <a class="nav-link text-nowrap @(Context.Request.Path.StartsWithSegments("/Dashboard/AccessPolicies") ? "active" : "") ms-4" asp-page="/Dashboard/AccessPolicies/Index">
                        <i class="bi bi-sliders2-vertical me-2"></i> Access Policies
                    </a>
                    <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Privacy") ? "active" : "")" asp-page="/Privacy">
                        <i class="bi bi-eye-slash-fill me-2"></i> Privacy
                    </a>
                </nav>
            </div>

            <!-- Footer -->
            <div class="sidebar-footer">
                @if (HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated ?? false)
                {
                    <div class="d-flex align-items-center gap-2 text-white-50 small mb-3">
                        <i class="bi bi-person fs-5 m-0 p-0"></i>
                        <span class="fw-light m-0 p-0">@HttpContextAccessor.HttpContext.User.Identity?.Name</span>
                    </div>
                    <form method="post" action="/account/logout">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-light btn-sm w-100">Logout</button>
                    </form>
                }
                else
                {
                    <a href="/account/login" class="btn btn-outline-light btn-sm w-100">Login</a>
                }
            </div>
        </div>

        <!-- Main content -->
        <div class="main">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
