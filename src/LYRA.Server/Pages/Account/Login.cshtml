@page
@model LYRA.Server.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="text-light p-4 rounded shadow-sm"
         style="width: 100%; max-width: 400px; background: linear-gradient(135deg, #1a1a1a, #000000);">
        <h2 class="mb-4 text-center">
            <i class="bi bi-person-badge me-2"></i> Login
        </h2>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control bg-dark text-light border-secondary" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger" />
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control bg-dark text-light border-secondary" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-outline-light w-100">Login</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}