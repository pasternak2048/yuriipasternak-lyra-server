@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-semibold text-dark d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-shield-shaded fs-2 align-middle"></i>
            LYRA.Server
        </h1>
        <p class="text-muted fs-5 mb-1">
            <span class="text-dark fw-semibold">L</span>et
            <span class="text-dark fw-semibold">Y</span>ourself
            <span class="text-dark fw-semibold">R</span>emain
            <span class="text-dark fw-semibold">A</span>uthenticated
        </p>
        <p class="text-muted fs-5">
            Secure, policy-driven trust management between systems, services, APIs, queues, and more.
        </p>
    </div>

    <div class="d-flex flex-wrap justify-content-center gap-4">
        <div class="feature-card bg-lyra-dark p-4 shadow-sm" style="width: 300px;">
            <h5 class="fw-normal mb-2">
                <i class="bi bi-building me-2 text-light"></i> Companies
            </h5>
            <p class="mb-0 lyra-muted">
                Define organizations that publish and validate requests from trusted sources.
            </p>
        </div>

        <div class="feature-card bg-lyra-dark p-4 shadow-sm" style="width: 300px;">
            <h5 class="fw-normal mb-2">
                <i class="bi bi-diagram-3-fill me-2 text-light"></i> Touchpoints
            </h5>
            <p class="mb-0 lyra-muted">
                Declare internal or external access points that issue or receive signed requests.
            </p>
        </div>

        <div class="feature-card bg-lyra-dark p-4 shadow-sm" style="width: 300px;">
            <h5 class="fw-normal mb-2">
                <i class="bi bi-sliders2-vertical me-2 text-light"></i> Access Policies
            </h5>
            <p class="mb-0 lyra-muted">
                Define which touchpoints can interact, using flexible context types like HTTP, events or queues.
            </p>
        </div>

        <div class="feature-card bg-lyra-dark p-4 shadow-sm" style="width: 300px;">
            <h5 class="fw-normal mb-2">
                <i class="bi bi-shield-check me-2 text-light"></i> Signature Engine
            </h5>
            <p class="mb-0 lyra-muted">
                HMAC or RSA-based signature validation with shared or unique secrets.
            </p>
        </div>
    </div>

    <div class="text-center mt-5">
        <a href="/Dashboard/Index" class="btn btn-dark btn-lg d-inline-flex align-items-center gap-2">
            <i class="bi bi-bar-chart-line"></i>
            Go to Dashboard
        </a>
    </div>
</div>